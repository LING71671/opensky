{
  "name": "opensky",
  "version": "0.1.0",
  "description": "OpenSky: Universal Computer Use Engine & MCP Server for AI Agents",
  "type": "module",
  "bin": {
    "opensky": "./dist/bin/opensky.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build:helper": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-helper.ps1",
    "build": "pnpm build:helper && tsup",
    "dev": "tsx watch src/index.ts",
    "test:engine": "tsx tests/test-engine.ts",
    "test:decoupled": "tsx tests/test-decoupled-architecture.ts",
    "test": "tsx tests/test-engine.ts && tsx tests/test-decoupled-architecture.ts"
  },
  "keywords": [
    "computer-use",
    "mcp",
    "windows",
    "automation",
    "ai-agent",
    "ui-automation"
  ],
  "author": "LING71671",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LING71671/opensky.git"
  },
  "homepage": "https://github.com/LING71671/opensky#readme",
  "bugs": {
    "url": "https://github.com/LING71671/opensky/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.14.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
